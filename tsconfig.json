{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src", "naive", "virtual", "web-component", "csv", "header-groups", "accessibility", "spreadsheet"]
}
