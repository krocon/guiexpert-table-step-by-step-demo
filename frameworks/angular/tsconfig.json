{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "noImplicitOverride": true
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts", "../../src/model/*.ts", "../../src/data/*.ts"]
}
