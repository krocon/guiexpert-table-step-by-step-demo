{
  "name": "guiexpert-table-step-by-step-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frameworks/*"
  ],
  "description": "Demo app for the video series „GuiExpert Table Schritt für Schritt“ – one git tag per episode (ep-001 …).",
  "scripts": {
