    "dev:angular": "npm run dev -w frameworks/angular"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "dependencies": {
    "@guiexpert/table": "1.1.88",
    "@guiexpert/webcomponent-table": "1.1.88"
  }
}
